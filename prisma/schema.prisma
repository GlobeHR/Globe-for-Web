datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

generator client {
    provider = "prisma-client-js"
}

model User {
    robloxId   BigInt @id
    username   String
    rankId     Int 
    rank       String // temp
    logs       String // temp 
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}